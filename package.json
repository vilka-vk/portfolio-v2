{
  "name": "violetta-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build && node scripts/prerender.mjs && node scripts/copy-assets.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "test": "node --test scripts/page-motion.test.mjs scripts/typography.test.mjs",
    "typography": "node scripts/typography.mjs --write",
    "check:typography": "node scripts/typography.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "border-beam": "^1.4.1",
    "gsap": "^3.15.0",
    "html-react-parser": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typograf": "^7.8.0",
    "vite": "^7.0.0"
  }
}
